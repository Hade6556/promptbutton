{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "*.ts",
    "renderer",
    "../src/llm",
    "../src/mascot",
    "../src/messaging.ts",
    "../src/utils",
    "../src/adapters/editable.ts",
    "../web/src/components.tsx"
  ]
}
