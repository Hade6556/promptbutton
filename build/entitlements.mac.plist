<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 needs JIT and unsigned executable memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Lets the ad-hoc build load Electron's own frameworks, which carry a different signature. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Voice: the dictate helper records from the microphone. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- AppleScript fallback for reading and pasting into apps the Accessibility helper cannot reach. -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
