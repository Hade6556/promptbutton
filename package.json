{
  "name": "promptbutton",
  "version": "0.1.0",
  "private": true,
  "description": "One press: reads the conversation, asks what the model still needs, rewrites your prompt.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "postinstall": "wxt prepare",
    "eval": "node --import tsx eval/run.mts && node --import tsx eval/judge.mts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "proxy": "node --import tsx proxy/server.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "preact": "^11.2.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^8.3.7",
    "wxt": "latest"
  }
}
