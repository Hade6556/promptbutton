{
  "name": "promptbutton",
  "productName": "First Try",
  "version": "0.4.2",
  "private": true,
  "description": "One press: reads the conversation, asks what the model still needs, rewrites your prompt.",
  "author": "First Try",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p desktop",
    "postinstall": "wxt prepare",
    "eval": "node --env-file-if-exists=.env --import tsx eval/run.mts && node --env-file-if-exists=.env --import tsx eval/judge.mts",
    "eval:ablate": "node --env-file-if-exists=.env --import tsx eval/ablate.mts",
    "eval:gen": "node --env-file-if-exists=.env --import tsx eval/gen-cases.mts",
    "kb": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --import tsx kb/cli.mts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "site": "vite site --port 5500 --strictPort",
    "dev:staging": "vite site --port 5500 --strictPort --open /stage/avatar/preview.html",
    "site:deploy": "bash scripts/deploy-site.sh",
    "dash:build": "esbuild src/mascot/dash.ts --bundle --format=esm --minify --target=es2020 --outfile=site/assets/dash.js",
    "dash:assets": "npm run dash:build && node scripts/make-dash-assets.mjs",
    "test": "node --import tsx --test test/*.test.mts && npm run server:test",
    "server:test": "cd server && node --test test/*.test.mts",
    "server:deploy": "bash scripts/deploy-server.sh",
    "vps:setup": "bash scripts/setup-vps.sh",
    "proxy": "node --env-file-if-exists=.env --import tsx proxy/server.mts",
    "desktop:build": "npm run desktop:helper && npm run desktop:bundle",
    "desktop": "npm run desktop:build && env -u ELECTRON_RUN_AS_NODE electron .",
    "desktop:bundle": "esbuild desktop/main.ts desktop/preload.ts --bundle --platform=node --target=node22 --format=cjs --outdir=desktop/dist --out-extension:.js=.cjs --packages=external --sourcemap && vite build --config desktop/vite.renderer.config.ts",
    "desktop:helper": "mkdir -p desktop/bin && xcrun swiftc -O -o desktop/bin/axhelper desktop/native/axhelper.swift && xcrun swiftc -O -o desktop/bin/dictate desktop/native/dictate.swift -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker desktop/native/dictate-Info.plist",
    "paste-test": "npm run desktop:helper && esbuild scripts/paste-test.ts --bundle --platform=node --target=node22 --format=cjs --outfile=desktop/dist/paste-test.cjs --packages=external --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron desktop/dist/paste-test.cjs",
    "desktop:identity": "bash scripts/make-signing-identity.sh",
    "desktop:dist": "bash scripts/package-mac.sh",
    "desktop:dist:win": "bash scripts/package-win.sh",
    "release:upload": "bash scripts/upload-release.sh",
    "release:upload:win": "bash scripts/upload-release-win.sh",
    "smoke": "node --env-file-if-exists=.env --import tsx eval/smoke.mts",
    "cost": "node --env-file-if-exists=.env --import tsx eval/cost.mts",
    "voice-smoke": "node --env-file-if-exists=.env --import tsx eval/voice.mts",
    "collab-smoke": "node --env-file-if-exists=.env --import tsx eval/collab.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "preact": "^11.2.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^8.3.7",
    "wxt": "latest"
  },
  "main": "desktop/dist/main.cjs",
  "build": {
    "appId": "ai.firstry.mac",
    "productName": "First Try",
    "copyright": "© 2026 First Try",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "desktop/dist/**/*",
      "!desktop/dist/**/*.map",
      "!desktop/dist/paste-test.*",
      "desktop/assets/**/*",
      "public/icon/**/*"
    ],
    "asarUnpack": [
      "desktop/bin/**",
      "desktop/bin-win/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0",
      "x64ArchFiles": "**/desktop/bin/*",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Voice input: what you say is turned into text or an edit to your prompt.",
        "NSSpeechRecognitionUsageDescription": "Voice input is transcribed with macOS speech recognition, on-device when your language supports it.",
        "NSAppleEventsUsageDescription": "Reads and writes the text field you are typing in when an app does not expose it to Accessibility."
      },
      "files": [
        "desktop/bin/axhelper",
        "desktop/bin/dictate"
      ]
    },
    "dmg": {
      "artifactName": "Firstry-${version}-universal.${ext}",
      "title": "First Try ${version}",
      "writeUpdateInfo": false
    },
    "afterPack": "build/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "desktop/bin-win/winhelper.exe",
        "desktop/bin-win/winhelper.exe.config"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "First Try",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Firstry-Setup-${version}.${ext}"
    }
  }
}
